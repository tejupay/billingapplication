{
  "name": "business-erp-desktop",
  "version": "1.0.0",
  "description": "Business ERP AI Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "frontend:build": "npm --prefix frontend run build",
    "app": "electron .",
    "build:exe": "npm run frontend:build && electron-builder"
  },
  "build": {
    "appId": "com.businesserp.app",
    "productName": "Business ERP AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^29.1.0"
  }
}
